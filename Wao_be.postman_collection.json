{
  "info": {
    "_postman_id": "f6e2f7ff-7a11-4ab9-b4a2-c087cc03aa0e",
    "name": "Wao_be API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for Wao_be health tracking backend."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "userId", "value": "1" },
    { "key": "foodId", "value": "1" },
    { "key": "exerciseId", "value": "1" },
    { "key": "programId", "value": "1" },
    { "key": "logId", "value": "1" },
    { "key": "date", "value": "2026-03-21" },
    { "key": "from", "value": "2026-03-01" },
    { "key": "to", "value": "2026-03-21" }
  ],
  "item": [
    {
      "name": "Users",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"123456\",\n  \"fullName\": \"Nguyen Van A\"\n}"
            },
            "url": "{{baseUrl}}/api/users/register"
          }
        },
        {
          "name": "Get All Users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users"
          }
        },
        {
          "name": "Get User By Id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Update User",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Nguyen Van B\",\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        },
        {
          "name": "Delete User",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/users/{{userId}}"
          }
        }
      ]
    },
    {
      "name": "Health Profiles",
      "item": [
        {
          "name": "Create Health Profile",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gender\": \"MALE\",\n  \"dob\": \"1998-01-20\",\n  \"heightCm\": 172,\n  \"weightKg\": 70,\n  \"activityLevel\": \"MODERATELY_ACTIVE\",\n  \"goalType\": \"MAINTAIN\"\n}"
            },
            "url": "{{baseUrl}}/api/users/{{userId}}/health-profiles"
          }
        },
        {
          "name": "Get Latest Health Profile",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/{{userId}}/health-profiles/latest"
          }
        },
        {
          "name": "Get Health Profile History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/{{userId}}/health-profiles/history"
          }
        }
      ]
    },
